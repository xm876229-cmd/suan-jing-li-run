{
  "manifest_version": 3,
  "name": "净利取数助手",
  "version": "0.24.32",
  "description": "在店铺后台记录数据接口，并把结果回传给本地净利核算程序",
  "permissions": [
    "storage",
    "scripting",
    "downloads",
    "tabs",
    "webRequest",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "https://*.tiktok.com/*",
    "https://*.tiktokglobalshop.com/*",
    "https://*.tiktokv.com/*",
    "https://*.byteoversea.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tiktok.com/*",
        "https://*.tiktokglobalshop.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.tiktok.com/*",
        "https://*.tiktokglobalshop.com/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "净利取数助手"
  }
}
