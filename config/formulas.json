{
  "_readme": [
    "════ 这是一张「参数表」，每一行是一个参与计算的参数 ════",
    "",
    "  每一行都有 kinds（适用订单类别）。想改口径就改这个数组，不用改代码。",
    "  改动即时生效，不用重启程序。",
    "",
    "  五个订单类别（一行订单只归一类，优先级从上到下）：",
    "    cancelled    已取消订单     取消类型不含 return/refund",
    "    refunded     退货退款订单   取消类型含 return / refund",
    "    zero_amount  0 元样品单     GMV 与实付都是 0",
    "    unpaid       未付款订单",
    "    normal       正常订单",
    "  注意既是取消单又是 0 元的，归 cancelled（优先级在先）。",
    "",
    "  每一行可以写的字段：",
    "    id       唯一标识，公式里用它引用金额（别乱改，公式在用）",
    "    label    中文名",
    "    base     基数，取这些类别订单的什么：",
    "               gmv / buyer_paid / order_count / items / cost / refund",
    "               commission（达人佣金，直接取数）、ads（广告花费，直接取数）",
    "    rate     乘数。不写 = 1（原样取数）。可写数字，或 params.xxx 引用国家费率",
    "    kinds    只在这些订单类别上算。不写 = 全部类别。写 [] = 这一项不算",
    "    enabled  false = 暂时不算这一项",
    "",
    "  举例：",
    "    发单费只算正常单和退货退款 → \"kinds\": [\"normal\",\"refunded\"]",
    "    平台佣金只算正常单（取消/退货平台退佣）→ \"kinds\": [\"normal\"]",
    "    商品成本四类都算（货已采购发出）→ \"kinds\": [\"normal\",\"cancelled\",\"refunded\",\"zero_amount\"]",
    "",
    "  加一项新支出（比如订单服务费每单 2 元，只算正常单）：在 params 里加一条",
    "    {\"id\":\"order_service\",\"label\":\"订单服务费\",\"base\":\"order_count\",\"rate\":2.0,\"kinds\":[\"normal\"]}",
    "  它就会自动进 net 的计算，公式不用改（因为 net 用的是 sum(params)）。",
    "",
    "  注意：id 为 gmv / cost / order_count / items / buyer_paid 的五项有固定去处，",
    "  会分别显示在报表的 GMV / 商品成本 / 订单数 / 件数 / 买家实付 列；",
    "  其余 id 都会进「费用明细」。",
    "",
    "════ formulas：净利怎么算 ════",
    "  可用变量：params 里每一项的 id、params.xxx（国家费率）、",
    "           gross_profit / total_fees / net 等已定义的结果。",
    "  可用函数：sum / abs / min / max / round。"
  ],
  "kinds": {
    "cancelled": "已取消订单",
    "refunded": "退货退款订单",
    "zero_amount": "0 元样品单",
    "unpaid": "未付款订单",
    "normal": "正常订单"
  },
  "params": [
    {
      "id": "gmv",
      "label": "GMV（收入）",
      "base": "gmv",
      "kinds": [
        "normal",
        "zero_amount"
      ]
    },
    {
      "id": "buyer_paid",
      "label": "买家实付",
      "base": "buyer_paid",
      "kinds": [
        "normal",
        "zero_amount"
      ]
    },
    {
      "id": "order_count",
      "label": "订单数",
      "base": "order_count",
      "kinds": [
        "normal",
        "cancelled",
        "refunded",
        "zero_amount"
      ]
    },
    {
      "id": "items",
      "label": "件数",
      "base": "items",
      "kinds": [
        "normal",
        "cancelled",
        "refunded",
        "zero_amount"
      ]
    },
    {
      "id": "cost",
      "label": "商品成本",
      "base": "cost",
      "kinds": [
        "normal",
        "cancelled",
        "refunded",
        "zero_amount"
      ]
    },
    {
      "id": "dispatch",
      "label": "发单费",
      "base": "order_count",
      "rate": "params.dispatch_fee_local",
      "kinds": [
        "normal",
        "cancelled",
        "refunded",
        "zero_amount"
      ]
    },
    {
      "id": "platform_commission",
      "label": "平台佣金",
      "base": "gmv",
      "rate": "params.platform_commission",
      "kinds": [
        "normal",
        "cancelled",
        "refunded"
      ]
    },
    {
      "id": "tx_fee",
      "label": "交易手续费",
      "base": "buyer_paid",
      "rate": "params.tx_fee",
      "kinds": [
        "normal",
        "cancelled",
        "refunded"
      ]
    },
    {
      "id": "cashback",
      "label": "奖金返现",
      "base": "gmv",
      "rate": "params.cashback",
      "kinds": [
        "normal"
      ]
    },
    {
      "id": "super_coupon",
      "label": "超级优惠券",
      "base": "gmv",
      "rate": "params.super_coupon",
      "kinds": [
        "normal"
      ],
      "enabled": false
    },
    {
      "id": "growth_fee",
      "label": "商家成长",
      "base": "gmv",
      "rate": "params.growth_fee",
      "kinds": [
        "normal"
      ]
    },
    {
      "id": "logistics",
      "label": "物流",
      "base": "gmv",
      "rate": "params.logistics",
      "kinds": [
        "normal"
      ]
    },
    {
      "id": "affiliate",
      "label": "达人佣金",
      "base": "commission"
    },
    {
      "id": "ads",
      "label": "广告花费",
      "base": "ads"
    }
  ],
  "formulas": {
    "gross_profit": "gmv - cost",
    "total_fees": "sum(fees)",
    "net": "gross_profit - total_fees",
    "net_rate": "net / gmv"
  }
}
