{
  "_readme": [
    "════ 计算参数表：每一行就是一条算式 ════",
    "",
    "  每一项都能直接写公式（expr）。公式里能用的变量：",
    "",
    "  ① 列映射里的字段（config/mapping.json 里的逻辑字段名）",
    "     subtotal_before   折扣前小计",
    "     seller_discount   卖家折扣",
    "     order_amount      买家实付",
    "     refund_amount     退款金额",
    "     qty               件数",
    "",
    "  ② 由上面派生的量",
    "     gmv          = 折扣前小计 − 卖家折扣",
    "     cost         = 件数 × 成本单价（成本单价来自成本表：商品编码 → 成本）",
    "     cost_unit    平均成本单价",
    "     orders       订单数",
    "     commission   达人佣金（整期直接取数）",
    "     ads          广告花费（整期直接取数）",
    "",
    "  ③ 国家费率：params.字段名（在「费率」页按国家维护）",
    "  ④ 其它参数算出来的值：写它的 id 就行（如佣金引用 gmv），顺序无所谓",
    "",
    "  可用运算符：+ - * / ( )，函数：sum() abs() min() max() round()",
    "",
    "  每一项的字段：",
    "    id       唯一标识（净利公式里引用它；别乱改）",
    "    label    中文名",
    "    expr     计算公式 ← 核心，改这里就等于改算法",
    "    kinds    只算哪些订单类别：normal / cancelled / refunded / zero_amount / unpaid",
    "             不写 = 全部类别；写 [] = 这一项不算",
    "    enabled  false = 暂时不算",
    "    role     报表固定列：gmv / cost / order_count / items / buyer_paid",
    "             有 role 的项不进「费用合计」，其余项都进",
    "",
    "  净利公式在下面的 formulas 里，默认：net = gmv − cost − 全部费用",
    "",
    "  by_country：某个国家要单独一套参数就写在这里，",
    "              形如 \"马来西亚\": {\"params\": [ …整张表… ]}；没写的国家用上面这套。",
    "",
    "  改错了不会崩：报表会提示哪一条公式有问题，该项按 0 计。"
  ],
  "kinds": {
    "cancelled": "已取消订单",
    "refunded": "退货退款订单",
    "zero_amount": "0 元样品单",
    "unpaid": "未付款订单",
    "normal": "正常订单"
  },
  "params": [
    {
      "id": "gmv",
      "label": "GMV（收入）",
      "role": "gmv",
      "expr": "subtotal_before - seller_discount",
      "kinds": [
        "normal",
        "zero_amount"
      ]
    },
    {
      "id": "cost",
      "label": "商品成本",
      "role": "cost",
      "expr": "qty * cost_unit",
      "kinds": [
        "normal",
        "cancelled",
        "refunded",
        "zero_amount"
      ]
    },
    {
      "id": "order_count",
      "label": "订单数",
      "role": "order_count",
      "expr": "orders",
      "kinds": [
        "normal",
        "cancelled",
        "refunded",
        "zero_amount"
      ]
    },
    {
      "id": "items",
      "label": "件数",
      "role": "items",
      "expr": "qty",
      "kinds": [
        "normal",
        "cancelled",
        "refunded",
        "zero_amount"
      ]
    },
    {
      "id": "buyer_paid",
      "label": "买家实付",
      "role": "buyer_paid",
      "expr": "order_amount",
      "kinds": [
        "normal",
        "zero_amount"
      ]
    },
    {
      "id": "dispatch",
      "label": "发单费",
      "expr": "orders * params.dispatch_fee_local",
      "kinds": [
        "normal",
        "cancelled",
        "refunded",
        "zero_amount"
      ]
    },
    {
      "id": "platform_commission",
      "label": "平台佣金",
      "expr": "gmv * params.platform_commission",
      "kinds": [
        "normal",
        "cancelled",
        "refunded"
      ]
    },
    {
      "id": "tx_fee",
      "label": "交易手续费",
      "expr": "order_amount * params.tx_fee",
      "kinds": [
        "normal",
        "cancelled",
        "refunded"
      ]
    },
    {
      "id": "cashback",
      "label": "奖金返现",
      "expr": "gmv * params.cashback",
      "kinds": [
        "normal"
      ]
    },
    {
      "id": "super_coupon",
      "label": "超级优惠券",
      "expr": "gmv * params.super_coupon",
      "kinds": [
        "normal"
      ],
      "enabled": false
    },
    {
      "id": "growth_fee",
      "label": "商家成长",
      "expr": "gmv * params.growth_fee",
      "kinds": [
        "normal"
      ]
    },
    {
      "id": "logistics",
      "label": "物流",
      "expr": "gmv * params.logistics",
      "kinds": [
        "normal"
      ]
    },
    {
      "id": "affiliate",
      "label": "达人佣金",
      "expr": "commission"
    },
    {
      "id": "ads",
      "label": "广告花费",
      "expr": "ads"
    }
  ],
  "formulas": {
    "gross_profit": "gmv - cost",
    "total_fees": "sum(fees)",
    "net": "gmv - cost - sum(fees)",
    "net_rate": "net / gmv"
  }
}
