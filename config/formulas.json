      ]
    }
  },
  "params": [
    {
      "id": "gmv",
      "label": "GMV（收入）",
      "role": "gmv",
      "expr": "[折扣前小计|SKU Subtotal Before Discount|SKU折扣前小计] - [卖家折扣|SKU Seller Discount|SKU卖家折扣]",
      "kinds": [
        "normal",
        "zero_amount"
      ]
    },
    {
      "id": "cost",
      "label": "商品成本",
      "role": "cost",
      "expr": "cost_cny * params.cny_to_local",
      "kinds": [
        "normal",
        "zero_amount"
      ]
    },
    {
      "id": "order_count",
      "label": "订单数",
      "role": "order_count",
      "expr": "orders",
      "kinds": [
        "normal",
        "refunded",
        "zero_amount"
      ]
    },
    {
      "id": "items",
      "label": "件数",
      "role": "items",
      "expr": "qty",
      "kinds": [
        "normal",
        "refunded",
        "zero_amount"
      ]
    },
    {
      "id": "buyer_paid",
      "label": "买家实付",
      "role": "buyer_paid",
      "expr": "paid",
      "kinds": [
        "normal",
        "zero_amount"
      ]
    },
    {
      "id": "dispatch",
      "label": "发单费",
      "expr": "orders * params.dispatch_fee_cny * params.cny_to_local",
      "kinds": [
        "normal",
        "refunded",
        "zero_amount"
      ]
    },
    {
      "id": "platform_commission",
      "label": "平台佣金",
      "expr": "gmv * params.platform_commission",
      "kinds": [
        "normal",
        "zero_amount"
      ]
    },
    {
      "id": "tx_fee",
      "label": "交易手续费",
      "expr": "paid * params.tx_fee",
      "kinds": [
        "normal",
        "zero_amount"
      ]
    },
    {
      "id": "ads",
      "label": "广告花费",
      "expr": "ads"
    },
    {
      "id": "affiliate",
      "label": "达人佣金",
      "expr": "commission"
    },
    {
      "id": "cashback",
      "label": "奖金返现",
      "expr": "gmv * params.cashback",
      "kinds": [
        "normal",
        "zero_amount"
      ]
    },
    {
      "id": "order_service",
      "label": "订单服务费",
      "expr": "orders * params.order_service",
      "kinds": [
        "normal",
        "refunded",
        "zero_amount"
      ]
    }
  ],
  "formulas": {
    "gross_profit": "gmv - cost",
    "total_fees": "dispatch + platform_commission + tx_fee + cashback + ads + affiliate + order_service",
    "net": "gmv - cost - dispatch - platform_commission - tx_fee - cashback - ads - affiliate - order_service",
    "net_rate": "net / gmv"
  },
  "by_country": {}
}
