# ===== Excel / Office 临时与锁文件 =====
~$*
*.tmp
*.swp
*.crdownload

# ===== 计算产出（可随时重新生成，不入库） =====
报表/*
!报表/.gitkeep

# ===== 抓包原始数据（含店铺数据，不入库） =====
数据/capture/*.jsonl
数据/exports/*
!数据/.gitkeep
!数据/exports/README.md
!数据/capture/endpoints.json
*.out.xlsx
*.out.csv
*.log

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# ===== 编辑器 / 系统 =====
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ===== 本地环境变量 / 密钥 =====
.env
.env.*
!.env.example
*.pem
*.key

# ===== 明确保留（不要删） =====
# .workbuddy/ 为项目相关数据目录，正常纳入版本管理，不在此忽略

数据/capture/task.log

数据/costs/*
!数据/costs/README.md

数据/mapping/*
!数据/mapping/README.md

# 汇率缓存（联网抓来的实时汇率，随时会过期，不入库）
数据/fx_cache.json

# ===== 打包产物（可随时重建，不入库） =====
release/
build/

# 每家店的抓取数据与店铺元信息（运行时产生，不入库）
数据/stores/
# 核算历史（走势图数据，本机产生）
数据/history.jsonl

# 应用预设前的自动备份（临时数据，不入库）
配置/_backup/

# 本机数据根标记（含绝对路径，每台机器不同，不入库）
数据目录.txt

# 清空数据前的本地备份（临时，不入库）
_backup_*/

# 取数诊断样本（临时，不入库）
数据/capture/_last_*.json

# ===== 备份目录（体积大、含客户数据，不入库） =====
备份_*/
