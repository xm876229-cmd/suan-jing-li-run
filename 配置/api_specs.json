{
  "_readme": [
    "取数规格：扩展不再写死任何接口，只按这里的定义执行。",
    "加新数据源 = 加一段 JSON，不用改扩展、不用刷新扩展。",
    "",
    "字段说明：",
    "  tasks.<任务名>.host      用哪个域名的页面发请求（seller / affiliate）",
    "  steps[].path            接口路径（相对域名）",
    "  steps[].method          GET / POST",
    "  steps[].body            请求体模板，字符串里的 {{变量}} 会被替换",
    "  steps[].take            从响应里取数据的路径，如 data.table_v2",
    "  steps[].layout          columnar（第一行是列名）/ objects（每行一个对象）",
    "  steps[].fields          逻辑字段 → 源列名候选列表（按顺序取第一个有的）",
    "  steps[].group_by        按这些字段分组",
    "  steps[].sum             这些字段在组内求和",
    "  steps[].output.file     落地文件名，可用 {{变量}}",
    "  steps[].output.header   CSV 表头",
    "  steps[].output.columns  输出列（逻辑字段名），与 header 一一对应"
  ],
  "vars": {
    "startDate": "区间起始日（含），如 2026-10-01",
    "endDate": "区间结束日（含），如 2026-10-15",
    "endDateExclusive": "结束日的次日（开区间），如 2026-10-16",
    "tzOffset": "时区偏移（秒）",
    "storeId": "店铺 id",
    "startDateCompact": "起始日紧凑格式，如 20261001",
    "endDateCompact": "结束日紧凑格式，如 20261015"
  },
  "tasks": {
    "ads": {
      "label": "广告 · 商品维度花费",
      "host": "seller",
      "steps": [
        {
          "name": "商品维度花费",
          "path": "/oec_ads/shopping/v1/oec/stat/post_product_list_v2",
          "method": "POST",
          "body": {
            "query_list": [
              "product_name",
              "campaign_id",
              "campaign_name",
              "product_id",
              "product_status",
              "campaign_is_del",
              "campaign_opt_status",
              "campaign_create_channel",
              "product_picture",
              "related_campaign_count",
              "session_info",
              "campaign_no_bid_budget",
              "gmv_max_bid_type",
              "campaign_target_roi_budget_mode",
              "campaign_target_roi_budget",
              "active_creative_boost_count",
              "mixed_real_cost",
              "onsite_roi2_shopping_sku",
              "mixed_real_cost_per_onsite_roi2_shopping_sku",
              "onsite_roi2_shopping_value",
              "onsite_mixed_real_roi2_shopping",
              "spu_bi_appeal_info"
            ],
            "start_time": "{{startDate}}",
            "end_time": "{{endDate}}",
            "order_field": "mixed_real_cost",
            "order_type": 1,
            "page": 1,
            "page_size": 100,
            "filters": [
              {
                "field": "campaign_status",
                "filter_type": 0,
                "in_field_values": [
                  "no_delete"
                ]
              },
              {
                "field": "gmv_roi_mode",
                "in_field_values": [
                  "2"
                ],
                "filter_type": 10
              }
            ],
            "dims": [
              "spu_id"
            ]
          },
          "take": "data.table_v2",
          "layout": "cells",
          "fields": {
            "product_id": [
              "product_id",
              "spu_id",
              "productid"
            ],
            "spend": [
              "mixed_real_cost",
              "cost",
              "billed_cost",
              "basic_cost",
              "spend"
            ],
            "currency": [
              "extra_currency",
              "currency"
            ],
            "name": [
              "product_name",
              "title"
            ]
          },
          "group_by": [
            "product_id",
            "currency"
          ],
          "sum": [
            "spend"
          ],
          "output": {
            "file": "creative data for product campaigns ({{startDate}} 00 ~ {{endDate}} 23).csv",
            "header": [
              "Product ID",
              "Spend",
              "Currency",
              "Product name"
            ],
            "columns": [
              "product_id",
              "spend",
              "currency",
              "name"
            ]
          },
          "set": {
            "currency": "LOCAL"
          }
        }
      ]
    },
    "affiliate": {
      "label": "联盟佣金 · 商品维度",
      "host": "affiliate",
      "steps": [
        {
          "name": "商品维度佣金",
          "path": "/api/v1/oec/affiliate/compass/transaction/detail_list/get",
          "method": "POST",
          "body": {
            "params": {
              "detail_list_type": 2,
              "product_list_params": [
                {
                  "time_descriptor": {
                    "granularity_type": 1,
                    "timezone_offset": "{{tzOffset}}",
                    "start_time": "{{startTs}}",
                    "end_time": "{{endTs}}",
                    "time_option_type": 1,
                    "time_context": "101"
                  },
                  "metric_types": [
                    1,
                    3,
                    2,
                    4,
                    9,
                    20,
                    13,
                    14,
                    19,
                    6,
                    12,
                    11,
                    16,
                    17,
                    18,
                    8,
                    7,
                    10,
                    5
                  ],
                  "page_param": {
                    "page_no": 1,
                    "page_size": 20
                  },
                  "sorter": {
                    "sort_type": 1,
                    "order_type": 1
                  },
                  "filter": {}
                }
              ]
            },
            "module_type": 104,
            "locale": "en"
          },
          "take": "data.product_list_segments.*.product_performances",
          "layout": "objects",
          "fields": {
            "product_id": [
              "product_base.id",
              "product_id",
              "spu_id"
            ],
            "commission": [
              "product_metrics.product_estimated_commission.amount",
              "est_commission",
              "commission"
            ],
            "gmv": [
              "product_metrics.product_gmv.amount",
              "gmv"
            ],
            "orders": [
              "product_metrics.product_orders_cnt.value",
              "orders"
            ],
            "items": [
              "product_metrics.product_items_sold_cnt.value",
              "items"
            ],
            "refund_gmv": [
              "product_metrics.product_refunded_gmv.amount",
              "refund_gmv"
            ],
            "name": [
              "product_base.title",
              "product_name",
              "title"
            ]
          },
          "group_by": [
            "product_id"
          ],
          "sum": [
            "commission",
            "gmv",
            "orders",
            "items",
            "refund_gmv"
          ],
          "output": {
            "file": "Transaction_Analysis_Product_List_{{startDateCompact}}_{{endDateCompact}}.csv",
            "header": [
              "Product ID",
              "Est. commission",
              "Product name",
              "Product GMV",
              "Orders",
              "Items sold",
              "Refunded GMV"
            ],
            "columns": [
              "product_id",
              "commission",
              "name",
              "gmv",
              "orders",
              "items",
              "refund_gmv"
            ]
          }
        }
      ]
    }
  }
}
